{
  "manifest_version": 3,
  "name": "DS-pwsh Terminal Bridge",
  "version": "1.1.2",
  "description": "Runs DS-pwsh commands through a local terminal bridge on DeepSeek.",
  "key": "",
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "DS-pwsh Terminal Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["command-utils.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
